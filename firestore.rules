// Firestore Rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin status is read from the user's own profile document. Firebase custom
    // claims (request.auth.token.role) would be cheaper, but setting them requires
    // the Admin SDK server-side, and this project has no Cloud Functions.
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    // A disabled account must not be able to re-enable itself. Only admins set
    // this field; everyone else has to leave it exactly as it is, including
    // leaving it absent when it was absent.
    function disabledUnchanged() {
      return !('disabled' in request.resource.data.keys())
        ? !('disabled' in resource.data.keys())
        : ('disabled' in resource.data.keys()
           && request.resource.data.disabled == resource.data.disabled);
    }

    // A guide may edit their own listing (bio, prices, photo, availability…) but
    // must NOT be able to change the trust/reputation fields an admin controls.
    // Otherwise a guide could self-verify or inflate their own rating from the
    // browser console. Every guide doc is created by admin approval with all of
    // these fields set, so the comparisons are always defined on update.
    function guideTrustFieldsUnchanged() {
      return request.resource.data.verified == resource.data.verified
        && request.resource.data.idVerified == resource.data.idVerified
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.reviewCount == resource.data.reviewCount
        && request.resource.data.totalBookings == resource.data.totalBookings
        && request.resource.data.status == resource.data.status;
    }

    // Users: a user reads only their OWN profile; admins read any. Profiles hold
    // PII (name + email), so a blanket signed-in read let any account enumerate
    // every user's email from the browser console. Chat peer display no longer
    // reads this collection — it uses the public /guides doc and the peer info
    // already embedded on the chat document (see ChatPage).
    // A user may edit their own profile but may NOT change their own role or
    // their disabled flag, otherwise any account could grant itself admin, or
    // un-ban itself, from the browser console.
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId && roleUnchanged() && disabledUnchanged());
      allow delete: if isAdmin();
    }

    // Guide applications: anyone signed in may apply; only admins review them.
    match /guide_applications/{appId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == appId);
      allow create: if isSignedIn() && request.auth.uid == appId;
      allow update, delete: if isAdmin();
    }

    // Guides: public read so visitors can browse without signing in.
    //
    // Only an admin CREATES a guide listing — that happens when an admin
    // approves a guide_application. This is what keeps the public directory
    // trustworthy: a random signed-in user can no longer write guides/{ownUid}
    // to insert themselves as an (auto-verified) guide without going through
    // review. A guide may UPDATE their own listing, but not the trust fields.
    match /guides/{guideId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == guideId && guideTrustFieldsUnchanged());
      allow delete: if isAdmin();
    }

    // Bookings: the visitor who booked, the assigned guide, or an admin.
    // Field is visitorId (the previous rules checked touristId, which the app
    // never writes, so the visitor branch was dead).
    match /bookings/{bookingId} {
      // Read is scoped to the parties on the booking (or an admin). A blanket
      // signed-in read let any account dump every booking on the platform —
      // visitor names, emails, guides, dates and amounts. The dashboards query
      // their own bookings (where visitorId / guideId == uid), which these
      // per-document conditions permit; the admin panel lists all via isAdmin().
      allow read: if isAdmin()
        || (isSignedIn() && (
             resource.data.visitorId == request.auth.uid
             || resource.data.guideId == request.auth.uid
             || resource.data.guideUid == request.auth.uid
           ));
      allow create: if isSignedIn() && request.resource.data.visitorId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isSignedIn() && (
             resource.data.visitorId == request.auth.uid
             || resource.data.guideId == request.auth.uid
             || resource.data.guideUid == request.auth.uid
           ));
    }

    // Reviews: publicly readable (shown on guide profiles), written by the reviewer.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Subscriptions: own record only.
    match /subscriptions/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Chats: participants only, plus admins.
    //
    // Admin read is required for the System tab's database wipe: deleting a
    // collection means first listing it, and Firestore evaluates a list query
    // against the rule as a whole rather than per document, so an admin who is
    // not a participant cannot enumerate chats at all. Without this the wipe
    // deletes the earlier collections and then dies here, which is exactly how
    // it half-completed before.
    //
    // The cost is real and worth stating plainly: an admin can read every
    // private conversation on the platform. Firestore cannot express "may list
    // in order to delete but may not read", so this is the price of running the
    // wipe from the browser at all.
    //
    // On create the document does not exist yet, so the participants list must
    // be read from request.resource, not resource.
    match /chats/{chatId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();

      // Messages live in a subcollection and are not covered by the parent rule.
      match /messages/{messageId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }
  }
}
