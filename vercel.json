{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/search", "destination": "/app.html" },
    { "source": "/guide/:path*", "destination": "/app.html" },
    { "source": "/booking/:path*", "destination": "/app.html" },
    { "source": "/sign-in", "destination": "/app.html" },
    { "source": "/login", "destination": "/app.html" },
    { "source": "/register", "destination": "/app.html" },
    { "source": "/guide-register", "destination": "/app.html" },
    { "source": "/guide-dashboard", "destination": "/app.html" },
    { "source": "/dashboard", "destination": "/app.html" },
    { "source": "/settings", "destination": "/app.html" },
    { "source": "/chat", "destination": "/app.html" },
    { "source": "/chat/:path*", "destination": "/app.html" },
    { "source": "/admin", "destination": "/app.html" },
    { "source": "/ymy-console", "destination": "/app.html" },
    { "source": "/payment/:path*", "destination": "/app.html" },
    { "source": "/subscription/:path*", "destination": "/app.html" }
  ]
}
