rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // The app uploads to a folder per user: profile_photos/{uid}/<file> and
    // id_documents/{uid}/<file> (see uploadFile calls in GuideRegistration and
    // AccountSettings). The previous rules matched a single path segment and a
    // {uid}_profile filename, neither of which the app produces, so deploying
    // them would deny every upload. These match the real folder-based paths.

    // Profile photos: a user writes only inside their own folder; public read
    // so guide photos render for anyone browsing.
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ID documents: a user writes only inside their own folder. Read is limited
    // to the owner. Admins review these through the tokenised download URL saved
    // on the application record, which grants access without a rule match, so no
    // admin branch is needed here (Storage rules cannot read Firestore to check
    // an admin role anyway, and this project sets no custom claims).
    match /id_documents/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else: public read, no writes.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
