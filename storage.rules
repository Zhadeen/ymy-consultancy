rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User directories: profile_photos and id_documents
    // Rules allow authenticated users to upload their own files
    match /profile_photos/{fileName} {
      allow read: if true; // Publicly readable profile photos
      allow write: if request.auth != null && fileName == request.auth.uid + "_profile";
    }
    
    match /id_documents/{fileName} {
      allow read: if request.auth != null && (fileName == request.auth.uid + "_id" || request.auth.token.role == 'admin');
      allow write: if request.auth != null && fileName == request.auth.uid + "_id";
    }

    // Default: Deny all other writes, allow public reads (as per app requirements)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
